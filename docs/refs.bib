  howpublished = {Wikipedia},
  note         = {Permanent revision as of 13:46, 22 December 2025 (UTC).},
  abstract     = {In number theory, a perfect number is a positive integer equal to the sum of its positive proper divisors (equivalently, its aliquot sum). Even perfect numbers are characterized by the Euclid--Euler theorem and correspond to Mersenne primes via the form 2^{p-1}(2^{p}-1) when 2^{p}-1 is prime. It is unknown whether any odd perfect numbers exist, and it is also unknown whether there are infinitely many perfect numbers.},
}

